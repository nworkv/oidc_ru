# Порт этого наблюдательного сервера
PORT=8085

# Публичный URL сервера (используется как redirect_uri в тестовых запросах)
APP_URL=http://localhost:8085

# Секрет для express-session (можно любую строку)
SESSION_SECRET=observer-demo-secret-change-me

# URL сервера авторизации Keycloak — только для справки в логах
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=test-realm
KEYCLOAK_CLIENT_ID=client-id
